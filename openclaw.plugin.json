{
  "id": "contextforge-native",
  "name": "ContextForge v2 Native Engine",
  "version": "2.0.0",
  "description": "Model-agnostic, elastic SQLite context engine with source-backed L0-L3 Wiki compilation, multimodal CAS hydration, and Dual-Channel Symbolic IR prompt compression.",
  "kind": "context-engine",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "cf_recall",
      "cf_remember",
      "cf_permanent",
      "cf_ingest",
      "cf_wiki_lint",
      "cf_status"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dbPath": {
        "type": "string"
      },
      "blobRoot": {
        "type": "string"
      },
      "maxFixedOverheadRatio": {
        "type": "number",
        "minimum": 0.05,
        "maximum": 0.8
      },
      "symbolicIr": {
        "type": "boolean"
      },
      "bridgePolicy": {
        "type": "object",
        "additionalProperties": false,
        "default": {
          "enabled": false
        },
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "importSnapshots": {
            "type": "boolean",
            "default": false
          },
          "supplement": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "default": 16
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000,
            "default": 2000
          }
        }
      }
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
